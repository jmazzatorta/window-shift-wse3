// fr_pe.csl - free-routing window-shift testbench, per-PE program.
//
// TRANSPORT: the window-shift state machine validated on device in proto_shift
// (done=256/256, 0 sentinel errors), kept identical in structure:
//   - one block in flight per direction, chained async send/recv;
//   - strict emit/drain alternation per direction (never simultaneous);
//   - parity colors (sender out-color == receiver in-color);
//   - sentinel word[SENT] carries the hop count; a block is forwarded only while
//     hop < RADIUS; local termination by expected arrival count n_from_*;
//   - Phase X (KZ sequential row passes), then Phase Y (one column sub-shift per
//     row-buffer block).
// The FMM math (M2L apply) is gone. It is replaced by verify_and_count(), a
// synthetic consumer that checks every delivered message and folds it into
// per-PE counters the host compares against a Python model (fr_model.py).
//
// MESSAGE FORMAT (MSG_WORDS payload words + 1 sentinel word):
//   word[0]      = origin id + 1   (origin id = oy*width + ox), as f32 (exact)
//   word[1]      = lane + 1        (lane = 0..KZ-1)
//   word[i>=2]   = fill(origin, lane, i)  (known pattern; checks the whole body)
//   word[SENT]   = hop count (transport only)
//
// ROW BUFFER: block b = s*KZ + lane, s = row slot:
//   s = 0          own position (dx = 0)
//   s = 1..R       West neighbours, dx = -s
//   s = R+1..2R    East neighbours, dx = s - R
// Phase Y column-shifts every VALID block (source column inside the mesh).
// Validity depends only on pe_x, so every PE of a column skips the same blocks
// and the column stays in lockstep.
//
// DELIVERY: a PE "consumes" each window message exactly once, in Phase Y:
//   dy = 0  : its own row-buffer block (delivered in Phase X, or its own data),
//   dy = +h : arrival from the South at hop h,
//   dy = -h : arrival from the North at hop h.
// So every PE consumes (1+n_from_w+n_from_e) * (1+n_from_n+n_from_s) * KZ
// messages, its own included.

param memcpyParams;

param color_e_even: color;  param color_e_odd: color;
param color_w_even: color;  param color_w_odd: color;
param color_n_even: color;  param color_n_odd: color;
param color_s_even: color;  param color_s_odd: color;
param parity_x: u16;
param parity_y: u16;

param tx_done_e_id: local_task_id;  param rx_done_e_id: local_task_id;
param tx_done_w_id: local_task_id;  param rx_done_w_id: local_task_id;
param tx_done_n_id: local_task_id;  param rx_done_n_id: local_task_id;
param tx_done_s_id: local_task_id;  param rx_done_s_id: local_task_id;

param pe_x: u16;
param pe_y: u16;
param width: u16;
param height: u16;
param RADIUS: u16;
param MSG_WORDS: u16;
param KZ: u16;

const MSG: u16 = MSG_WORDS;
const MSG_W: u16 = MSG + 1;
const SENT: u16 = MSG;
const NSLOT: u16 = 2 * RADIUS + 1;
const NBLK: u16 = NSLOT * KZ;

comptime {
  @comptime_assert(MSG >= 2);           // header needs origin + lane
  @comptime_assert(RADIUS >= 1);
  @comptime_assert(KZ >= 1);
  // Row-buffer offsets are passed to @increment_dsd_offset as i16.
  @comptime_assert(@as(u32, NBLK) * @as(u32, MSG) < 32768);
  // Header ids and lane keys stay within u16 without overflow.
  @comptime_assert(@as(u32, width) * @as(u32, height) * @as(u32, KZ) < 32768);
}

const sys_mod = @import_module("<memcpy/memcpy>", memcpyParams);

const c_e_out = if (parity_x == 0) color_e_even else color_e_odd;
const c_e_in  = if (parity_x == 0) color_e_odd  else color_e_even;
const c_w_out = if (parity_x == 0) color_w_even else color_w_odd;
const c_w_in  = if (parity_x == 0) color_w_odd  else color_w_even;
const c_n_out = if (parity_y == 0) color_n_even else color_n_odd;
const c_n_in  = if (parity_y == 0) color_n_odd  else color_n_even;
const c_s_out = if (parity_y == 0) color_s_even else color_s_odd;
const c_s_in  = if (parity_y == 0) color_s_odd  else color_s_even;

const e_iq = @get_input_queue(2);  const e_oq = @get_output_queue(2);
const w_iq = @get_input_queue(3);  const w_oq = @get_output_queue(3);
const n_iq = @get_input_queue(4);  const n_oq = @get_output_queue(4);
const s_iq = @get_input_queue(5);  const s_oq = @get_output_queue(5);

// Row buffer: NBLK blocks of MSG words, flat (block b at offset b*MSG).
var rowbuf = @zeros([NBLK * MSG]f32);

var done  = @zeros([1]u32);
// stats (host-verified):
//   [0] consumed messages        [1] sum of keys
//   [2] sum of lo^2 + hi^2 of key (lo/hi = low/high byte)
//   [3] header errors (origin/lane != expected)
//   [4] payload word errors      [5] X sentinel/order errors
//   [6] Y sentinel/order errors  [7] finished flag
// key = origin*KZ + lane + 1, decoded from the RECEIVED header.
var stats = @zeros([8]u32);
// dbg (progress, for hang diagnosis):
//   [0] recv from E (W chain)  [1] recv from W (E chain)  [2] tx W  [3] tx E
//   [5] recv from S            [6] recv from N            [7] tx N  [8] tx S
//   [12] X pass<<8 | dirs done [13] cur_blk               [14] Phase Y started
var dbg   = @zeros([16]u32);

var ptr_done  : [*]u32 = &done;
var ptr_stats : [*]u32 = &stats;
var ptr_dbg   : [*]u32 = &dbg;

var carry_e = @zeros([MSG_W]f32);  var rxtmp_e = @zeros([MSG_W]f32);
var carry_w = @zeros([MSG_W]f32);  var rxtmp_w = @zeros([MSG_W]f32);
var carry_n = @zeros([MSG_W]f32);  var rxtmp_n = @zeros([MSG_W]f32);
var carry_s = @zeros([MSG_W]f32);  var rxtmp_s = @zeros([MSG_W]f32);

const tx_dsd_e = @get_dsd(fabout_dsd, .{ .extent = MSG_W, .output_queue = e_oq });
const rx_dsd_e = @get_dsd(fabin_dsd,  .{ .extent = MSG_W, .input_queue  = e_iq });
const tx_dsd_w = @get_dsd(fabout_dsd, .{ .extent = MSG_W, .output_queue = w_oq });
const rx_dsd_w = @get_dsd(fabin_dsd,  .{ .extent = MSG_W, .input_queue  = w_iq });
const tx_dsd_n = @get_dsd(fabout_dsd, .{ .extent = MSG_W, .output_queue = n_oq });
const rx_dsd_n = @get_dsd(fabin_dsd,  .{ .extent = MSG_W, .input_queue  = n_iq });
const tx_dsd_s = @get_dsd(fabout_dsd, .{ .extent = MSG_W, .output_queue = s_oq });
const rx_dsd_s = @get_dsd(fabin_dsd,  .{ .extent = MSG_W, .input_queue  = s_iq });

const carry_e_wire = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG_W} -> carry_e[i] });
const rxtmp_e_wire = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG_W} -> rxtmp_e[i] });
const carry_e_data = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG}   -> carry_e[i] });
const rxtmp_e_data = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG}   -> rxtmp_e[i] });
const carry_w_wire = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG_W} -> carry_w[i] });
const rxtmp_w_wire = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG_W} -> rxtmp_w[i] });
const carry_w_data = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG}   -> carry_w[i] });
const rxtmp_w_data = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG}   -> rxtmp_w[i] });
const carry_n_wire = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG_W} -> carry_n[i] });
const rxtmp_n_wire = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG_W} -> rxtmp_n[i] });
const carry_n_data = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG}   -> carry_n[i] });
const rxtmp_n_data = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG}   -> rxtmp_n[i] });
const carry_s_wire = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG_W} -> carry_s[i] });
const rxtmp_s_wire = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG_W} -> rxtmp_s[i] });
const carry_s_data = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG}   -> carry_s[i] });
const rxtmp_s_data = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG}   -> rxtmp_s[i] });

// DSD anchored at row-buffer block 0. Per-block access shifts it by b*MSG via
// @increment_dsd_offset (a runtime index is not allowed in tensor_access).
const rowbuf0Dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MSG} -> rowbuf[i] });

const has_west: bool = pe_x > 0;
const has_east: bool = pe_x < width - 1;
const has_north: bool = pe_y > 0;
const has_south: bool = pe_y < height - 1;

// Expected arrivals per direction (window clipped at the mesh edge).
const n_from_w: u16 = if (pe_x < RADIUS) pe_x else RADIUS;
const east_room: u16 = width - 1 - pe_x;
const n_from_e: u16 = if (east_room < RADIUS) east_room else RADIUS;
const n_from_n: u16 = if (pe_y < RADIUS) pe_y else RADIUS;
const south_room: u16 = height - 1 - pe_y;
const n_from_s: u16 = if (south_room < RADIUS) south_room else RADIUS;

// All on-PE integer arithmetic is u16: the PE has no 32-bit integer multiply
// (cslc/LLVM fails with "Cannot select: i32 = mul"). Every product below is
// bounded so that it never exceeds 65535; u32 is used only for the exported
// accumulators, which only ever ADD u16 values.
const MY_ID: u16 = pe_y * width + pe_x;

// ===========================================================================
// SYNTHETIC PAYLOAD + CONSUMER
// ===========================================================================
// Known fill pattern, overflow-free in u16:
//   (o&0x7FF)*13 + (i&0x7FF)*7 + (l&0x3F)*3 <= 26611 + 14329 + 189 < 65536.
// Integer-valued and <= 41130, so exact in f32.
fn fill(o: u16, l: u16, i: u16) f32 {
  const v: u16 = (o & 0x7FF) * 13 + (i & 0x7FF) * 7 + (l & 0x3F) * 3 + 1;
  return @as(f32, v);
}

// Write this PE's KZ own messages into row-buffer blocks 0..KZ-1 (slot s = 0).
fn seed_own_blocks() void {
  var zb: u16 = 0;
  while (zb < KZ) : (zb += 1) {
    const base: u16 = zb * MSG;
    rowbuf[base] = @as(f32, MY_ID + 1);
    rowbuf[base + 1] = @as(f32, zb + 1);
    var i: u16 = 2;
    while (i < MSG) : (i += 1) {
      rowbuf[base + i] = fill(MY_ID, zb, i);
    }
  }
}

var cur_dx: i16 = 0;    // planar X offset of the block being column-shifted
var cur_lane: u16 = 0;  // its lane

// Verify one delivered message and fold it into stats. `dy` is its Y offset.
// Header is checked against the position the transport claims it came from;
// the body is checked against fill() of the RECEIVED header, so a corrupted
// body is caught even when the header is intact.
fn verify_and_count(buf: *[MSG_W]f32, dy: i16) void {
  const ox: u16 = @as(u16, @as(i16, pe_x) + cur_dx);
  const oy: u16 = @as(u16, @as(i16, pe_y) + dy);
  const exp_id: u16 = oy * width + ox;          // < width*height (asserted)

  const got_o1: u16 = @as(u16, buf.*[0]);
  const got_l1: u16 = @as(u16, buf.*[1]);
  if (got_o1 != exp_id + 1 or got_l1 != cur_lane + 1) { stats[3] += 1; }

  // Decode (guard against a zero header so the fold stays defined).
  const o: u16 = if (got_o1 > 0) got_o1 - 1 else 0;
  const l: u16 = if (got_l1 > 0) got_l1 - 1 else 0;

  var bad: u16 = 0;
  var i: u16 = 2;
  while (i < MSG) : (i += 1) {
    if (buf.*[i] != fill(o, l, i)) { bad += 1; }
  }
  stats[4] += @as(u32, bad);

  // key = o*KZ + l + 1 < width*height*KZ + 1 <= 32768 (asserted).
  const key: u16 = o * KZ + l + 1;
  const lo: u16 = key & 0xFF;
  const hi: u16 = key >> 8;
  stats[0] += 1;
  stats[1] += @as(u32, key);
  stats[2] += @as(u32, lo * lo) + @as(u32, hi * hi);   // each <= 65025
}

// ===========================================================================
// PHASE X - EAST chain (send E / recv from W). For pass x_zb, West neighbour at
// offset k lands in row-buffer block k*KZ + x_zb.
// ===========================================================================
var x_zb: u16 = 0;
var recvd_w: u16 = 0;  var sp_e: u16 = 0;  var rxcl_e: bool = false;  var txcl_e: bool = false;
var recvd_e: u16 = 0;  var sp_w: u16 = 0;  var rxcl_w: bool = false;  var txcl_w: bool = false;
var x_dirs_done: u16 = 0;

fn x_dir_finished() void {
  x_dirs_done += 1;
  dbg[12] = (@as(u32, x_zb) << 8) | @as(u32, x_dirs_done);
  if (x_dirs_done == 2) { next_x_pass_or_phase_y(); }
}
fn arm_drain_e() void { @mov32(rxtmp_e_wire, rx_dsd_e, .{ .async = true, .activate = rx_done_e_id }); }
fn emit_e(hop: u16) void {
  carry_e[SENT] = @as(f32, hop);  sp_e += 1;  dbg[3] += 1;
  @mov32(tx_dsd_e, carry_e_wire, .{ .async = true, .activate = tx_done_e_id });
}
fn try_x_e() void { if (rxcl_e and txcl_e and sp_e == 0) { x_dir_finished(); } }
task txDoneE() void {
  sp_e -= 1;
  if (!rxcl_e and recvd_w < n_from_w) { arm_drain_e(); }
  try_x_e();
}
task rxDoneE() void {
  recvd_w += 1;  dbg[1] += 1;
  const hop: u16 = @as(u16, rxtmp_e[SENT]);
  if (hop != recvd_w) { stats[5] += 1; }
  const slotDsd = @increment_dsd_offset(rowbuf0Dsd, @as(i16, (recvd_w * KZ + x_zb) * MSG), f32);
  @fmovs(slotDsd, rxtmp_e_data);
  @fmovs(carry_e_data, rxtmp_e_data);
  const fwd = has_east and hop < RADIUS;
  const more = recvd_w < n_from_w;
  if (!more) { rxcl_e = true; txcl_e = true; }
  if (fwd) { emit_e(hop + 1); } else { if (more) { arm_drain_e(); } }
  try_x_e();
}

// ===========================================================================
// PHASE X - WEST chain (send W / recv from E). East neighbour at offset k lands
// in row-buffer block (R+k)*KZ + x_zb.
// ===========================================================================
fn arm_drain_w() void { @mov32(rxtmp_w_wire, rx_dsd_w, .{ .async = true, .activate = rx_done_w_id }); }
fn emit_w(hop: u16) void {
  carry_w[SENT] = @as(f32, hop);  sp_w += 1;  dbg[2] += 1;
  @mov32(tx_dsd_w, carry_w_wire, .{ .async = true, .activate = tx_done_w_id });
}
fn try_x_w() void { if (rxcl_w and txcl_w and sp_w == 0) { x_dir_finished(); } }
task txDoneW() void {
  sp_w -= 1;
  if (!rxcl_w and recvd_e < n_from_e) { arm_drain_w(); }
  try_x_w();
}
task rxDoneW() void {
  recvd_e += 1;  dbg[0] += 1;
  const hop: u16 = @as(u16, rxtmp_w[SENT]);
  if (hop != recvd_e) { stats[5] += 1; }
  const slotDsd = @increment_dsd_offset(rowbuf0Dsd, @as(i16, ((RADIUS + recvd_e) * KZ + x_zb) * MSG), f32);
  @fmovs(slotDsd, rxtmp_w_data);
  @fmovs(carry_w_data, rxtmp_w_data);
  const fwd = has_west and hop < RADIUS;
  const more = recvd_e < n_from_e;
  if (!more) { rxcl_w = true; txcl_w = true; }
  if (fwd) { emit_w(hop + 1); } else { if (more) { arm_drain_w(); } }
  try_x_w();
}

// One Phase-X pass for lane x_zb: shift own block rowbuf[x_zb] along the row.
fn start_x_pass() void {
  dbg[12] = (@as(u32, x_zb) << 8);
  const own = @increment_dsd_offset(rowbuf0Dsd, @as(i16, x_zb * MSG), f32);
  @fmovs(carry_e_data, own);
  @fmovs(carry_w_data, own);
  recvd_w = 0; sp_e = 0; rxcl_e = (n_from_w == 0); txcl_e = (n_from_w == 0);
  recvd_e = 0; sp_w = 0; rxcl_w = (n_from_e == 0); txcl_w = (n_from_e == 0);
  x_dirs_done = 0;

  if (has_east) { emit_e(1); } else if (n_from_w > 0) { arm_drain_e(); }
  if (has_west) { emit_w(1); } else if (n_from_e > 0) { arm_drain_w(); }

  // Account directions that had nothing to do.
  if (rxcl_e and txcl_e and sp_e == 0) { x_dir_finished(); }
  if (rxcl_w and txcl_w and sp_w == 0) { x_dir_finished(); }
}

fn next_x_pass_or_phase_y() void {
  x_zb += 1;
  if (x_zb < KZ) { start_x_pass(); } else { start_phase_y(); }
}

// ===========================================================================
// PHASE Y - one column sub-shift per VALID row-buffer block cur_blk.
// ===========================================================================
var cur_blk: u16 = 0;
// cur_blk = cur_slot*KZ + cur_lane, kept as counters: no runtime division
// (KZ is a param, so cur_blk/KZ would be a real u16 divide on the PE).
var cur_slot: u16 = 0;
fn next_blk() void {
  cur_blk += 1;
  cur_lane += 1;
  if (cur_lane == KZ) { cur_lane = 0; cur_slot += 1; }
}
var y_started: bool = false;
var recvd_s: u16 = 0;  var sp_n: u16 = 0;  var rxcl_n: bool = false;  var txcl_n: bool = false;
var recvd_n: u16 = 0;  var sp_s: u16 = 0;  var rxcl_s: bool = false;  var txcl_s: bool = false;
var y_dirs_done: u16 = 0;

// Planar X offset of row slot s (see header).
fn slot_dx(s: u16) i16 {
  if (s == 0) { return 0; }
  if (s <= RADIUS) { return -@as(i16, s); }
  return @as(i16, s - RADIUS);
}
// A slot is valid iff its source column is inside the mesh. Depends on pe_x
// only, hence identical for every PE of a column.
fn slot_valid(s: u16) bool {
  if (s == 0) { return true; }
  if (s <= RADIUS) { return s <= n_from_w; }
  return (s - RADIUS) <= n_from_e;
}

fn arm_drain_n() void { @mov32(rxtmp_n_wire, rx_dsd_n, .{ .async = true, .activate = rx_done_n_id }); }
fn emit_n(hop: u16) void {
  carry_n[SENT] = @as(f32, hop);  sp_n += 1;  dbg[7] += 1;
  @mov32(tx_dsd_n, carry_n_wire, .{ .async = true, .activate = tx_done_n_id });
}
fn arm_drain_s() void { @mov32(rxtmp_s_wire, rx_dsd_s, .{ .async = true, .activate = rx_done_s_id }); }
fn emit_s(hop: u16) void {
  carry_s[SENT] = @as(f32, hop);  sp_s += 1;  dbg[8] += 1;
  @mov32(tx_dsd_s, carry_s_wire, .{ .async = true, .activate = tx_done_s_id });
}

fn y_dir_finished() void {
  y_dirs_done += 1;
  if (y_dirs_done == 2) { next_blk(); advance_or_finish(); }
}
fn try_y_n() void { if (rxcl_n and txcl_n and sp_n == 0) { y_dir_finished(); } }
fn try_y_s() void { if (rxcl_s and txcl_s and sp_s == 0) { y_dir_finished(); } }

task txDoneN() void {
  sp_n -= 1;
  if (!rxcl_n and recvd_s < n_from_s) { arm_drain_n(); }
  try_y_n();
}
task rxDoneN() void {
  recvd_s += 1;  dbg[5] += 1;
  const hop: u16 = @as(u16, rxtmp_n[SENT]);
  if (hop != recvd_s) { stats[6] += 1; }
  verify_and_count(&rxtmp_n, @as(i16, hop));        // from the South: dy = +hop
  @fmovs(carry_n_data, rxtmp_n_data);
  const fwd = has_north and hop < RADIUS;
  const more = recvd_s < n_from_s;
  if (!more) { rxcl_n = true; txcl_n = true; }
  if (fwd) { emit_n(hop + 1); } else { if (more) { arm_drain_n(); } }
  try_y_n();
}

task txDoneS() void {
  sp_s -= 1;
  if (!rxcl_s and recvd_n < n_from_n) { arm_drain_s(); }
  try_y_s();
}
task rxDoneS() void {
  recvd_n += 1;  dbg[6] += 1;
  const hop: u16 = @as(u16, rxtmp_s[SENT]);
  if (hop != recvd_n) { stats[6] += 1; }
  verify_and_count(&rxtmp_s, -@as(i16, hop));       // from the North: dy = -hop
  @fmovs(carry_s_data, rxtmp_s_data);
  const fwd = has_south and hop < RADIUS;
  const more = recvd_n < n_from_n;
  if (!more) { rxcl_s = true; txcl_s = true; }
  if (fwd) { emit_s(hop + 1); } else { if (more) { arm_drain_s(); } }
  try_y_s();
}

fn start_sub_shift() void {
  dbg[13] = @as(u32, cur_blk);
  cur_dx = slot_dx(cur_slot);

  const src = @increment_dsd_offset(rowbuf0Dsd, @as(i16, cur_blk * MSG), f32);
  @fmovs(carry_n_data, src);
  @fmovs(carry_s_data, src);

  recvd_s = 0; sp_n = 0; rxcl_n = (n_from_s == 0); txcl_n = (n_from_s == 0);
  recvd_n = 0; sp_s = 0; rxcl_s = (n_from_n == 0); txcl_s = (n_from_n == 0);
  y_dirs_done = 0;

  // Consume the block itself (dy = 0) once.
  verify_and_count(&carry_n, 0);

  if (has_north) { emit_n(1); } else if (n_from_s > 0) { arm_drain_n(); }
  if (has_south) { emit_s(1); } else if (n_from_n > 0) { arm_drain_s(); }

  if (rxcl_n and txcl_n and sp_n == 0) { y_dir_finished(); }
  if (rxcl_s and txcl_s and sp_s == 0) { y_dir_finished(); }
}

// Skip blocks whose source column is off-mesh, then start the next sub-shift
// or finish.
fn advance_or_finish() void {
  while (cur_blk < NBLK and !slot_valid(cur_slot)) { next_blk(); }
  if (cur_blk < NBLK) {
    start_sub_shift();
  } else {
    stats[7] = 1;
    done[0] = 1;
    // run_shift already unblocked the command stream; do not unblock again.
  }
}

fn start_phase_y() void {
  if (y_started) { return; }
  y_started = true;
  dbg[14] = 1;
  cur_blk = 0;  cur_slot = 0;  cur_lane = 0;
  advance_or_finish();
}

export fn runtime_init() void {
  sys_mod.unblock_cmd_stream();
}

export fn run_shift() void {
  for (@range(u16, 8)) |i| { stats[i] = 0; }
  done[0] = 0;
  seed_own_blocks();
  x_zb = 0;
  y_started = false;
  start_x_pass();
  // Unblock immediately (validated proto pattern): the host polls done[] while
  // the routing runs to completion on the fabric.
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(txDoneE, tx_done_e_id);  @bind_local_task(rxDoneE, rx_done_e_id);
  @bind_local_task(txDoneW, tx_done_w_id);  @bind_local_task(rxDoneW, rx_done_w_id);
  @bind_local_task(txDoneN, tx_done_n_id);  @bind_local_task(rxDoneN, rx_done_n_id);
  @bind_local_task(txDoneS, tx_done_s_id);  @bind_local_task(rxDoneS, rx_done_s_id);

  @set_local_color_config(c_e_out, .{ .routes = .{ .rx = .{ RAMP },  .tx = .{ EAST } } });
  @set_local_color_config(c_e_in,  .{ .routes = .{ .rx = .{ WEST },  .tx = .{ RAMP } } });
  @set_local_color_config(c_w_out, .{ .routes = .{ .rx = .{ RAMP },  .tx = .{ WEST } } });
  @set_local_color_config(c_w_in,  .{ .routes = .{ .rx = .{ EAST },  .tx = .{ RAMP } } });
  @set_local_color_config(c_n_out, .{ .routes = .{ .rx = .{ RAMP },  .tx = .{ NORTH } } });
  @set_local_color_config(c_n_in,  .{ .routes = .{ .rx = .{ SOUTH }, .tx = .{ RAMP } } });
  @set_local_color_config(c_s_out, .{ .routes = .{ .rx = .{ RAMP },  .tx = .{ SOUTH } } });
  @set_local_color_config(c_s_in,  .{ .routes = .{ .rx = .{ NORTH }, .tx = .{ RAMP } } });

  if (@is_arch("wse3")) {
    @initialize_queue(e_iq, .{ .color = c_e_in });  @initialize_queue(e_oq, .{ .color = c_e_out });
    @initialize_queue(w_iq, .{ .color = c_w_in });  @initialize_queue(w_oq, .{ .color = c_w_out });
    @initialize_queue(n_iq, .{ .color = c_n_in });  @initialize_queue(n_oq, .{ .color = c_n_out });
    @initialize_queue(s_iq, .{ .color = c_s_in });  @initialize_queue(s_oq, .{ .color = c_s_out });
  }

  @export_symbol(ptr_done,  "done");
  @export_symbol(ptr_stats, "stats");
  @export_symbol(ptr_dbg,   "dbg");
  @export_symbol(runtime_init);
  @export_symbol(run_shift);
}
